<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Elements\SubmitterText;
use Fisharebest\Webtrees\Fact;
use Fisharebest\Webtrees\Gedcom;
use Fisharebest\Webtrees\Http\Controllers\AddNewFact;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Note;
use Fisharebest\Webtrees\Registry;
use Illuminate\Support\Collection;

/**
 * @var bool                 $can_edit
 * @var Collection<int,Fact> $facts
 * @var Individual           $individual
 */

// Build a truncated preview of the first note for the accordion header.
$first_note_preview = '';
if ($facts->isNotEmpty()) {
    $first_fact = $facts->first();

    if ($first_fact->tag() === 'INDI:NOTE' || $first_fact->tag() === 'FAM:NOTE') {
        // Standalone note — value may be an xref or inline text
        $text = $first_fact->value();
        if (preg_match('/^@' . Gedcom::REGEX_XREF . '@$/', $text) === 1) {
            $note = Registry::noteFactory()->make(trim($text, '@'), $individual->tree());
            $text = $note instanceof Note ? $note->getNote() : '';
        }
        $first_note_preview = $text;
    } else {
        // Fact containing a 2 NOTE sub-record — extract the first one
        if (preg_match("/\n[1-9] NOTE ?(.*(?:\n\d.*)*)/", $first_fact->gedcom(), $match) === 1) {
            $first_note_preview = preg_replace('/\n\d CONT ?/', "\n", $match[1]);
        }
    }

    // Strip newlines and truncate
    $first_note_preview = preg_replace('/[\r\n]+/', ' ', $first_note_preview);
    $first_note_preview = trim($first_note_preview);
    if (mb_strlen($first_note_preview) > 80) {
        $first_note_preview = mb_substr($first_note_preview, 0, 80) . '…';
    }
}

?>
<div class="accordion-item">
    <div class="accordion-header" id="notes-header">
        <button class="accordion-button collapsed gap-1" type="button" data-bs-toggle="collapse" data-bs-target="#notes-content" aria-expanded="false" aria-controls="notes-content">
            <?= view('icons/expand') ?>
            <?= view('icons/collapse') ?>
            <span class="label"><?= I18N::translate('Notes') ?></span>
            <?php if ($first_note_preview !== '') : ?>
                <div><?= e($first_note_preview) ?></div>
            <?php endif ?>
        </button>
    </div>

    <div id="notes-content" class="accordion-collapse collapse" data-bs-parent="#individual-names" aria-labelledby="notes-header">
        <div class="accordion-body">
            <table class="table wt-facts-table">
                <?php if ($facts->isNotEmpty()) : ?>
                    <tr>
                        <td colspan="2">
                            <label>
                                <input id="show-level-2-notes-accordion" type="checkbox" data-bs-toggle="collapse" data-bs-target=".wt-level-two-note-accordion" data-wt-persist="level-two-notes-accordion" autocomplete="off">
                                <?= I18N::translate('Show all notes') ?>
                            </label>
                        </td>
                    </tr>
                <?php endif ?>

                <?php foreach ($facts as $fact) : ?>
                    <?php if ($fact->tag() === 'INDI:NOTE' || $fact->tag() === 'FAM:NOTE') : ?>
                        <?= view('fact', ['fact' => $fact, 'record' => $individual]) ?>
                    <?php else : ?>
                        <?php
                        if ($fact->isPendingAddition()) {
                            $styleadd = 'wt-new ';
                        } elseif ($fact->isPendingDeletion()) {
                            $styleadd = 'wt-old ';
                        } else {
                            $styleadd = '';
                        }
                        ?>

                        <tr class="wt-level-two-note-accordion collapse">
                            <th scope="row" class="rela <?= $styleadd ?>">
                                <?= $fact->label() ?>
                                <?= view('fact-edit-links', ['fact' => $fact, 'url' => $fact->record()->url() . '#tab-notes']) ?>
                            </th>

                            <td class="<?= $styleadd ?>">
                                <?php preg_match_all("/\n[1-9] NOTE ?(.*(?:\n\d CONT.*)*)/", $fact->gedcom(), $matches, PREG_SET_ORDER) ?>
                                <?php foreach ($matches as $match) : ?>
                                    <div class="mb-2">
                                        <?php $text = preg_replace('/\n\d CONT ?/', "\n", $match[1]) ?>
                                        <?php if (preg_match('/^@' . Gedcom::REGEX_XREF . '@$/', $text) === 1) : ?>
                                            <?php $note = Registry::noteFactory()->make(trim($text, '@'), $individual->tree()) ?>
                                            <?php if ($note instanceof Note) : ?>
                                                <?php if ($note->canShow()) : ?>
                                                    <a href="<?= e($note->url()) ?>">
                                                        <?= I18N::translate('Shared note') ?>
                                                        <?= view('icons/note') ?>
                                                    </a>
                                                    <?= (new SubmitterText(''))->value($note->getNote(), $individual->tree()) ?>
                                                <?php endif ?>
                                            <?php else : ?>
                                                <span class="error"><?= e($text) ?></span>
                                            <?php endif ?>
                                        <?php else : ?>
                                            <?= (new SubmitterText(''))->value($text, $individual->tree()) ?>
                                        <?php endif ?>
                                    </div>
                                <?php endforeach ?>
                            </td>
                        </tr>
                    <?php endif ?>
                <?php endforeach ?>

                <?php if ($facts->isEmpty()) : ?>
                    <tr>
                        <td colspan="2">
                            <?= I18N::translate('There are no notes for this individual.') ?>
                        </td>
                    </tr>
                <?php endif ?>

                <?php if ($can_edit) : ?>
                    <tr>
                        <th scope="row">
                            <?= I18N::translate('Note') ?>
                        </th>
                        <td>
                            <a href="<?= e(route(AddNewFact::class, ['tree' => $individual->tree()->name(), 'xref' => $individual->xref(), 'fact' => 'NOTE'])) ?>">
                                <?= I18N::translate('Add a note') ?>
                            </a>
                        </td>
                    </tr>
                <?php endif ?>
            </table>
        </div>
    </div>
</div>
