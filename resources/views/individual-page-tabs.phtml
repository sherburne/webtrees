<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Fact;
use Fisharebest\Webtrees\Http\RequestHandlers\ModuleAction;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Module\ModuleTabInterface;
use Fisharebest\Webtrees\Module\NotesTabModule;
use Illuminate\Support\Collection;

/**
 * @var Individual                         $record
 * @var Collection<int,ModuleTabInterface> $tabs
 */
?>

<div class="wt-tabs-individual" id="individual-tabs">
    <ul class="nav nav-tabs flex-wrap" role="tablist">
        <?php foreach ($tabs as $tab) : ?>
            <?php
            // Check if this is the notes tab and if the individual has at least one NOTE record (level-1)
            $has_notes = false;
            if ($tab instanceof NotesTabModule) {
                // Check for level-1 NOTE records in the individual's GEDCOM (not level-2 notes in facts)
                $has_notes = preg_match('/\n1 NOTE/', $record->gedcom() . ($record->pending ?? '')) === 1;
            }
            ?>
            <li class="nav-item" role="presentation">
                <a class="nav-link<?= $tab->isGrayedOut($record) ? ' text-muted' : '' ?>" id="<?= $tab->name() ?>-tab" data-bs-toggle="tab" role="tab" aria-controls="<?= $tab->name() ?>" aria-selected="false" data-wt-href="<?= e(route(ModuleAction::class, ['module' => $tab->name(), 'action' => 'Tab', 'tree' => $record->tree()->name(), 'xref' => $record->xref()])) ?>" href="#<?= $tab->name() ?>">
                    <?= $tab->tabTitle() ?><?= $has_notes ? ' ★' : '' ?>
                </a>
            </li>
        <?php endforeach ?>
    </ul>

    <div class="tab-content">
        <?php foreach ($tabs as $tab) : ?>
            <div id="<?= $tab->name() ?>" class="tab-pane mt-2 fade" role="tabpanel" aria-labelledby="<?= $tab->name() ?>-tab"><?php if (!$tab->canLoadAjax()) : ?><?= $tab->getTabContent($record) ?><?php endif ?></div>
        <?php endforeach ?>
    </div>
</div>
